# Ignore everything by default
*

# Then explicitly allow what we need
!package*.json
!next.config.mjs
!prisma/
!public/
!.next/
!app/
!components/
!lib/
!styles/
!tailwind.config.ts
!tsconfig.json
!postcss.config.js
!next-env.d.ts

# Ignore node_modules and build artifacts
node_modules
.next
dist
build
coverage

# Ignore logs and temp files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

# Ignore editor and system files
.vscode/
.idea/
*.swp
*.swo