generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================================================
// USER & AUTH
// ================================================

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String?
  role      Role     @default(TEACHER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacherClasses Class[] @relation("ClassTeacher")
  notifications  Notification[]
  notificationLogs NotificationLog[]

  @@map("users")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

// ================================================
// CORE ACADEMIC
// ================================================

model Class {
  id        String   @id @default(cuid())
  name      String
  level     String   // e.g. "Form 1", "Grade 7"
  teacherId String?
  teacher   User?    @relation("ClassTeacher", fields: [teacherId], references: [id])

  students  Student[]
  subjects  Subject[] @relation("ClassSubjects")
  exams     Exam[]
  timetable Timetable[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("classes")
}

model Subject {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?

  classes     Class[]  @relation("ClassSubjects")
  grades      Grade[]
  timetable   Timetable[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("subjects")
}

// ================================================
// STUDENTS & PARENTS
// ================================================

model Parent {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students  Student[]

  @@map("parents")
}

model Student {
  id        String   @id @default(cuid())
  name      String
  rollNumber String   @unique
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classId   String
  class     Class    @relation(fields: [classId], references: [id])

  parentId  String?
  parent    Parent?  @relation(fields: [parentId], references: [id])

  attendance Attendance[]
  grades     Grade[]
  invoices   Invoice[]

  @@map("students")
}

// ================================================
// ATTENDANCE
// ================================================

model Attendance {
  id        String            @id @default(cuid())
  date      DateTime
  status    AttendanceStatus  @default(PRESENT)
  studentId String
  student   Student           @relation(fields: [studentId], references: [id])

  @@unique([studentId, date])
  @@map("attendance")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

// ================================================
// EXAMS & GRADES
// ================================================

model Exam {
  id        String   @id @default(cuid())
  name      String
  term      String?
  date      DateTime
  createdAt DateTime @default(now())

  classId   String
  class     Class    @relation(fields: [classId], references: [id])

  grades    Grade[]

  @@map("exams")
}

model Grade {
  id        String   @id @default(cuid())
  marks     Int
  maxMarks  Int      @default(100)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id])
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id])

  @@unique([studentId, subjectId, examId])
  @@map("grades")
}

// ================================================
// TIMETABLE
// ================================================

model Timetable {
  id        String   @id @default(cuid())
  day       String
  startTime String
  endTime   String
  room      String?

  classId   String
  class     Class    @relation(fields: [classId], references: [id])

  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id])

  @@unique([classId, day, startTime])
  @@map("timetable")
}

// ================================================
// FEES & FINANCE
// ================================================

model FeeItem {
  id          String   @id @default(cuid())
  name        String
  amount      Float
  frequency   String   // once, monthly, termly, yearly
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoices    Invoice[]

  @@map("fee_items")
}

model Invoice {
  id          String        @id @default(cuid())
  studentId   String
  student     Student       @relation(fields: [studentId], references: [id])

  feeItemId   String?
  feeItem     FeeItem?      @relation(fields: [feeItemId], references: [id])

  amount      Float
  dueDate     DateTime
  status      InvoiceStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  payments    Payment[]

  @@map("invoices")
}

model Payment {
  id          String        @id @default(cuid())
  invoiceId   String
  invoice     Invoice       @relation(fields: [invoiceId], references: [id])

  amount      Float
  paymentDate DateTime      @default(now())
  method      String        // mpesa, cash, bank, etc.
  status      PaymentStatus @default(COMPLETED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("payments")
}

enum InvoiceStatus {
  PENDING
  PAID
  PARTIAL
  OVERDUE
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

// ================================================
// NOTIFICATIONS
// ================================================

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  createdAt DateTime @default(now())
  read      Boolean  @default(false)

  userId    String
  user      User     @relation(fields: [userId], references: [id])

  logs      NotificationLog[]

  @@map("notifications")
}

model NotificationLog {
  id             String       @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id])

  recipientId    String
  recipient      User         @relation(fields: [recipientId], references: [id])

  sentAt         DateTime     @default(now())
  status         String       // success, failed, pending
  errorMessage   String?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("notification_logs")
}