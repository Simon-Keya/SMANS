generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                   @id @default(cuid())
  name                    String?
  email                   String                   @unique
  emailVerified           DateTime?
  password                String?
  role                    Role                     @default(TEACHER)
  staffNo                 String?                  @unique
  phone                   String?
  profilePicture          String?
  lastLogin               DateTime?
  isActive                Boolean                  @default(true)
  createdById             String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  assignmentsCreated      Assignment[]             @relation("AssignmentCreator")
  auditLogs               AuditLog[]
  teacherClasses          Class[]                  @relation("ClassTeacher")
  emailVerificationTokens EmailVerificationToken[]
  approvedInvoices        Invoice[]                @relation("ApprovedByInvoice")
  createdInvoices         Invoice[]                @relation("CreatedByInvoice")
  notificationLogs        NotificationLog[]
  notifications           Notification[]
  parent                  Parent?                  @relation("UserParent")
  passwordResetTokens     PasswordResetToken[]
  approvedPayments        Payment[]                @relation("ApprovedByPayment")
  createdPayments         Payment[]                @relation("CreatedByPayment")
  student                 Student?                 @relation("UserStudent")
  createdBy               User?                    @relation("CreatedBy", fields: [createdById], references: [id])
  createdUsers            User[]                   @relation("CreatedBy")

  @@index([email])
  @@index([createdById])
  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token], map: "token_idx")
  @@index([userId], map: "userId_idx")
  @@map("email_verification_tokens")
}

model Class {
  id          String       @id @default(cuid())
  name        String
  level       String
  teacherId   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  assessments Assessment[]
  assignments Assignment[]
  attendance  Attendance[]
  teacher     User?        @relation("ClassTeacher", fields: [teacherId], references: [id])
  exams       Exam[]
  students    Student[]
  timetable   Timetable[]
  subjects    Subject[]    @relation("ClassSubjects")

  @@unique([name, level])
  @@index([teacherId])
  @@map("classes")
}

model Subject {
  id          String       @id @default(cuid())
  name        String
  code        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  assignments Assignment[]
  grades      Grade[]
  timetable   Timetable[]
  classes     Class[]      @relation("ClassSubjects")

  @@index([code])
  @@map("subjects")
}

model Parent {
  id           String    @id @default(cuid())
  name         String
  phone        String?
  email        String?   @unique
  occupation   String?
  relationship String?
  userId       String?   @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User?     @relation("UserParent", fields: [userId], references: [id])
  students     Student[]

  @@index([email])
  @@map("parents")
}

model Student {
  id              String         @id @default(cuid())
  name            String
  admissionNumber String         @unique
  email           String?
  phone           String?
  admissionDate   DateTime?
  dateOfBirth     DateTime?
  gender          String?
  address         String?
  classId         String
  parentId        String?
  userId          String?        @unique
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  attendance      Attendance[]
  grades          Grade[]
  invoices        Invoice[]
  promotions      PromotionLog[]
  class           Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  parent          Parent?        @relation(fields: [parentId], references: [id])
  user            User?          @relation("UserStudent", fields: [userId], references: [id])
  transcripts     Transcript[]

  @@index([admissionNumber])
  @@index([classId])
  @@map("students")
}

model LearningArea {
  id          String       @id @default(cuid())
  name        String
  code        String?      @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  assessments Assessment[]

  @@map("learning_areas")
}

model Assessment {
  id             String         @id @default(cuid())
  title          String
  learningAreaId String
  classId        String
  date           DateTime
  duration       Int
  maxScore       Int
  assessmentType AssessmentType @default(SUMMATIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  class          Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  learningArea   LearningArea   @relation(fields: [learningAreaId], references: [id], onDelete: Cascade)

  @@map("assessments")
}

model Assignment {
  id            String   @id @default(cuid())
  title         String
  description   String?
  dueDate       DateTime
  classId       String
  subjectId     String
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  class         Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdByUser User?    @relation("AssignmentCreator", fields: [createdBy], references: [id])
  subject       Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@map("assignments")
}

model Attendance {
  id        String           @id @default(cuid())
  date      DateTime
  status    AttendanceStatus @default(PRESENT)
  studentId String
  classId   String
  class     Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([studentId])
  @@index([classId, date])
  @@map("attendance")
}

model Exam {
  id        String   @id @default(cuid())
  name      String
  term      String?
  date      DateTime
  classId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  grades    Grade[]

  @@index([classId])
  @@map("exams")
}

model Grade {
  id              String   @id @default(cuid())
  studentId       String
  subjectId       String
  examId          String
  marks           Int
  maxMarks        Int      @default(100)
  assessmentType  String?
  competencyLevel String?
  remarks         String?
  published       Boolean  @default(false)
  weightedScore   Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  exam            Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject         Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId, examId])
  @@index([studentId])
  @@index([examId])
  @@index([subjectId])
  @@map("grades")
}

model Timetable {
  id        String  @id @default(cuid())
  day       String
  startTime String
  endTime   String
  room      String?
  classId   String
  subjectId String
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([classId, day, startTime])
  @@index([classId])
  @@map("timetable")
}

model FeeItem {
  id          String    @id @default(cuid())
  name        String
  amount      Float
  frequency   String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  invoices    Invoice[]

  @@map("fee_items")
}

model Invoice {
  id           String        @id @default(cuid())
  studentId    String
  feeItemId    String?
  amount       Float
  dueDate      DateTime
  status       InvoiceStatus @default(PENDING)
  createdById  String?
  approvedById String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  approvedBy   User?         @relation("ApprovedByInvoice", fields: [approvedById], references: [id])
  createdBy    User?         @relation("CreatedByInvoice", fields: [createdById], references: [id])
  feeItem      FeeItem?      @relation(fields: [feeItemId], references: [id])
  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payments     Payment[]

  @@index([studentId])
  @@index([createdById])
  @@index([approvedById])
  @@map("invoices")
}

model Payment {
  id           String        @id @default(cuid())
  invoiceId    String
  amount       Float
  method       String
  status       PaymentStatus @default(COMPLETED)
  paymentDate  DateTime      @default(now())
  createdById  String?
  approvedById String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  approvedBy   User?         @relation("ApprovedByPayment", fields: [approvedById], references: [id])
  createdBy    User?         @relation("CreatedByPayment", fields: [createdById], references: [id])
  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([createdById])
  @@index([approvedById])
  @@map("payments")
}

model Notification {
  id        String            @id @default(cuid())
  title     String
  message   String
  read      Boolean           @default(false)
  type      String?
  userId    String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  logs      NotificationLog[]
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationLog {
  id             String       @id @default(cuid())
  notificationId String
  recipientId    String
  status         String
  errorMessage   String?
  sentAt         DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  recipient      User         @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([recipientId])
  @@map("notification_logs")
}

model Transcript {
  id        String  @id @default(cuid())
  studentId String
  term      String
  year      Int
  gpa       Float?
  remarks   String?
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, term, year])
  @@index([studentId])
  @@map("transcripts")
}

model PromotionLog {
  id         String   @id @default(cuid())
  studentId  String
  fromClass  String
  toClass    String
  date       DateTime @default(now())
  approvedBy String?
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("promotion_logs")
}

model SchoolSettings {
  id                Int       @id @default(1)
  schoolName        String?
  logoUrl           String?
  address           String?
  phone             String?
  email             String?
  academicYearStart DateTime?
  academicYearEnd   DateTime?
  updatedAt         DateTime  @updatedAt

  @@map("school_settings")
}

model GeneralSettings {
  id                 Int      @id @default(1)
  emailNotifications Boolean  @default(true)
  smsNotifications   Boolean  @default(false)
  defaultTheme       String   @default("system")
  defaultLanguage    String   @default("en")
  defaultTimezone    String   @default("Africa/Nairobi")
  updatedAt          DateTime @updatedAt

  @@map("general_settings")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?    @db.Json
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model ScheduledSMS {
  id          String   @id @default(cuid())
  recipients  Json     // Store array of recipients
  message     String
  scheduledAt DateTime
  type        String   @default("GENERAL")
  senderId    String   @default("SMANS")
  label       String?
  status      String   @default("PENDING") // PENDING, SENT, FAILED, CANCELLED
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([scheduledAt])
  @@index([createdBy])
  @@map("scheduled_sms")
}


model Permission {
  id              String           @id @default(cuid())
  code            String           @unique
  name            String?
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]

  @@index([code])
  @@map("permissions")
}

model RolePermission {
  role         Role
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([role, permissionId])
  @@map("role_permissions")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  PARENT
  ACCOUNTANT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum InvoiceStatus {
  PENDING
  PAID
  PARTIAL
  OVERDUE
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum AssessmentType {
  FORMATIVE
  SUMMATIVE
  CBC_CHECK
}